# Copy to .env.local and fill in — never commit the real file.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Plaid (start in 'sandbox', request 'production' access once ready)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_WEBHOOK_URL=

# Postgres setting for token encryption — set this via the Supabase
# dashboard/CLI as a database setting, NOT here. This line is a reminder
# of what needs to exist, not something read directly by the app:
#   alter database postgres set app.plaid_token_key = '<a long random secret>';
# PLAID_TOKEN_ENCRYPTION_KEY=

# Anthropic (Claude API)
ANTHROPIC_API_KEY=
